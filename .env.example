# goblin-companion/.env.example
# Copia este archivo a .env — solo aporta los valores por defecto iniciales.
# Una vez el usuario guarda algo desde la ventana de Settings, electron-store
# (AppData) manda sobre estos valores (ver plan sección 10).

DJANGO_URL=http://127.0.0.1:8000
COMPANION_TOKEN=change-me
WATCHER_STABILITY_MS=2000
SYNC_COOLDOWN_SECONDS=10
LOCAL_SERVER_PORT=8765
